          "properties": {
            "city": {
              "description": "City name in Arabic, e.g. الرباط",
              "type": "string",
              "maxLength": 60
            },
            "role": {
              "description": "Role text to match, e.g. باريستا",
              "type": "string",
              "maxLength": 60
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "search_seekers",
        "title": "Search talent",
        "description": "List registered café workers (baristas, waiters, technicians), optionally filtered by city, profession or availability.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "city": {
              "type": "string",
              "maxLength": 60
